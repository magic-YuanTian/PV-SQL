# Copy this file to .env and fill in your own values.
# .env is listed in .gitignore -- never commit real credentials.
#
# These settings configure the OPTIONAL adapter in pvsql/llm.py. If you pass
# your own `llm` callable to PVSQL(...), none of this applies.

PVSQL_API_KEY=your-key-here
PVSQL_MODEL=gpt-4o

# Optional: a non-default chat-completions endpoint.
# PVSQL_BASE_URL=https://your-endpoint/v1

# ---------------------------------------------------------------------------
# Pipeline budgets (optional -- CLI flags override these)
# ---------------------------------------------------------------------------
# PVSQL_MAX_PROBES=5
# PVSQL_MAX_REPAIRS=3
# PVSQL_LLM_TIMEOUT=180
