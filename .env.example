# Copy this file to .env and fill in your own values.
# .env is listed in .gitignore -- never commit real credentials.
#
# These settings configure the OPTIONAL adapter in pvsql/llm.py. If you inject
# your own `llm` callable (see the README), none of this applies.

# ---------------------------------------------------------------------------
# Option A: OpenAI, or any OpenAI-compatible endpoint (default)
# ---------------------------------------------------------------------------
PVSQL_LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-key-here
PVSQL_MODEL=gpt-4o

# Point at a compatible endpoint other than api.openai.com:
# OPENAI_BASE_URL=https://your-endpoint/v1

# ---------------------------------------------------------------------------
# Option B: Azure OpenAI
# ---------------------------------------------------------------------------
# PVSQL_LLM_PROVIDER=azure
# AZURE_OPENAI_API_KEY=your-azure-key-here
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_VERSION=2024-10-01-preview
# PVSQL_MODEL=your-deployment-name

# ---------------------------------------------------------------------------
# Pipeline budgets (optional -- CLI flags override these)
# ---------------------------------------------------------------------------
# PVSQL_MAX_PROBES=5
# PVSQL_MAX_REPAIRS=3
# PVSQL_LLM_TIMEOUT=180
